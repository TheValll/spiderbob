<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spiderbob">
  <!-- Prototype v2 (modelisations/hexapode/v2): open frame without the cover, LiDAR table, planned onboard parts
       (Jetson Orin Nano 8 GB, Gens Ace 3S 5000 mAh battery, Pololu U3V70A step-up) in base_link.
       base_link mesh, mass, inertia and collisions recomputed; legs, camera, joint origins and limits unchanged
       (256 mm bed variant: corner coxa axes at x = +-109.5 mm, plates 250 x 195 mm). -->
  <xacro:property name="package_name" value="spiderbob_description"/>
  <xacro:arg name="camera_tilt_deg" default="10"/>
  <xacro:property name="camera_tilt_deg" value="$(arg camera_tilt_deg)"/>
  <xacro:property name="camera_tilt" value="${camera_tilt_deg * pi / 180}"/>
  <xacro:include filename="$(find ${package_name})/src/urdf/materials.xacro"/>
  <xacro:include filename="$(find ${package_name})/src/urdf/gazebo.xacro"/>
  <!-- base_footprint is the ground under the robot in the standing pose (foot bottoms 90.41 mm below base_link) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.09041" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  <link name="base_link">
